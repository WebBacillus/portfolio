    {
      "parameters": {
        "jsCode": "let exists = $input.first().json.existsRecords || []; // Handle potential undefined\nlet nonExists = $input.last().json.nonExistsRecords || []; // Handle potential undefined\n\nconst now = new Date();\nconst formattedDate = now.toLocaleDateString('en-US', { // You can change 'en-US' to your desired locale\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric',\n  hour: 'numeric',\n  minute: 'numeric',\n  second: 'numeric',\n  timeZoneName: 'short'\n});\n\nlet message = `*Report generated on: ${formattedDate}*\\n\\n*Exists:*\\n`;\n\nif (exists.length > 0) {\n  exists.forEach(record => {\n    message += `- ${record}\\n`;\n  });\n} else {\n  message += `_None_\\n`;\n}\n\nmessage += `\\n*Non-Exists:*\\n`;\nif (nonExists.length > 0) {\n  nonExists.forEach(record => {\n    message += `- ${record}\\n`;\n  });\n} else {\n  message += `_None_\\n`;\n}\n\nreturn [{\n  json: {\n    message: message\n  }\n}];"
      },
