# Resend API key used by the contact form server action.
# Get a key from https://resend.com/api-keys and copy this file to .env.local.
RESEND_API_KEY=

# Chat proxy server (leave CHAT_PUBLIC_ENABLED unset until launch checks pass).
CHAT_API_URL=
CHAT_INTERNAL_TOKEN=
CHAT_SESSION_SECRET=
CHAT_SESSION_CAP=30
CHAT_PUBLIC_ENABLED=false
